# Copy to .env.local (gitignored) and fill in real values. Never commit real secrets.

# The Odds API (https://the-odds-api.com) key — live multi-book odds and
# player props for the Trends/Props tool. Used only by server-side/build-time
# scripts (scripts/prepare-data.mjs, the GitHub Actions data-refresh cron) —
# never referenced from client-side code, since this is a static export with
# no server to hide it behind.
ODDS_API_KEY=

# CollegeFootballData.com (https://collegefootballdata.com) key — free
# registration. Real, maintained CFB EPA/PPA data for scripts/prepare-data.mjs
# (cfbfastR's own play-by-play archive is abandoned after 2021, hence a
# separate source). Same server-side-only rule as above.
CFBD_API_KEY=
